# Server
PORT=5000
NODE_ENV=development

# Default Admin (created via: npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@placementt.com
ADMIN_PASSWORD=Admin@987

# Database
MONGODB_URI=mongodb://localhost:27017/placement_tracker
MONGODB_PROD_URI=mongodb+srv://user:password@cluster.mongodb.net/placement_tracker

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production
JWT_EXPIRY=1h

# ─── Gmail Email (Password Reset) ────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password (select "Mail"), copy the 16-char password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM_NAME=Placement Tracker Security

# ─── Frontend / Client URL ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://placementtracker.com

# File Storage
UPLOAD_FILE_STORAGE=local
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Bcrypt
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
