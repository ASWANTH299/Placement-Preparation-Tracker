# Server
NODE_ENV=development
PORT=5000

# Required runtime configuration
MONGODB_URI=mongodb://localhost:27017/placement_tracker
JWT_SECRET=replace_with_at_least_32_characters_secure_secret
FRONTEND_URL=http://localhost:5173

# Token lifetime
JWT_EXPIRY=1h

# Admin seed script values (used only by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@placementtracker.dev
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Gmail email (password reset)
# Use Gmail App Password, not your normal account password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM_NAME=Placement Tracker Security

# Twilio SMS (optional; required only for OTP SMS flow)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File storage
UPLOAD_FILE_STORAGE=local
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Security and limits
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX_REQUESTS=120
