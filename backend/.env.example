# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/placement_tracker
MONGODB_PROD_URI=mongodb+srv://user:password@cluster.mongodb.net/placement_tracker

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production
JWT_EXPIRY=1h

# Email Service (fallback aliases for SMTP_USER/SMTP_PASS)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=Placement Tracker

# SMTP (recommended for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=your-email@gmail.com
EMAIL_FROM="Placement Tracker <your-email@gmail.com>"
SMTP_DEBUG=false

# Frontend URL
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://placementtracker.com

# File Storage
UPLOAD_FILE_STORAGE=local
UPLOAD_DIR=./uploads

# AWS S3 (For production)
AWS_S3_BUCKET=placement-tracker-resumes
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Bcrypt
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
